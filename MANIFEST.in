include README.md CHANGELOG.md PROVENANCE.md THIRD_PARTY.md .editorconfig .gitattributes .gitignore
include requirements-dev.in requirements-dev.lock requirements-security.txt
include requirements-test.in requirements-test.lock
include HANDOFF.md
recursive-include lessons *.md
recursive-include src *.py *.sql py.typed
recursive-include tests *.py
recursive-include scripts *.py
recursive-include examples *.json *.jsonl
recursive-include docs *.md
recursive-include research *.md
recursive-include reports *.md *.json
recursive-include .github *.yml
prune reports/checks
global-exclude __pycache__ *.py[cod] *.db
